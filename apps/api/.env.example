NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://enhora:enhora@localhost:5432/enhora
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Dispatcher (automatic courier assignment)
DISPATCH_ENABLED=true
DISPATCH_INTERVAL_MS=2000
OFFER_TTL_SECONDS=30
SEARCH_TIMEOUT_MINUTES=10
SCHEDULE_LEAD_MINUTES=15
MAX_CONCURRENT_JOBS=2
MAX_OFFER_DISTANCE_METERS=5000
COURIER_CASH_LIMIT_CENTS=5000000
COURIER_STALE_SECONDS=120
