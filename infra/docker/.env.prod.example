# Copy to /opt/enhora/.env on the VPS (bootstrap-vps.sh generates the secrets for you).
# Never commit the real file.

APP_HOST=app.enhora.net.ar
RIDER_HOST=cadete.enhora.net.ar
API_HOST=api.enhora.net.ar
APEX_HOST=enhora.net.ar

API_IMAGE=ghcr.io/sperattidev/enhora-api
WEB_IMAGE=ghcr.io/sperattidev/enhora-web
# Set by every deploy to the commit being released.
IMAGE_TAG=latest

LOG_LEVEL=info

# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install connector" token.
TUNNEL_TOKEN=
